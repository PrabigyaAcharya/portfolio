---
// Portrait.astro — the pixel portrait on the LCD: the ink mask that
// scripts/build-portrait.ts builds from the hand-drawn sprite, painted in
// --screen-ink. Sizes must be whole multiples of the sprite side (64 → 128,
// 192) so the pixels stay square and sharp. Without a sprite it renders nothing.
import { getPortrait } from '../lib/content';

export interface Props {
  size: number;
  /** Size at ≤700px wide; defaults to `size`. */
  small?: number;
}

const { size, small = size } = Astro.props;
const portrait = getPortrait();
const vars = `--size:${size}px; --size-sm:${small}px`;
---
{portrait && (
  <span class="portrait" role="img" aria-label={portrait.alt} style={`${vars}; --mask:url(${portrait.url})`}></span>
)}

<style>
  .portrait {
    display: block;
    flex: 0 0 auto;
    width: var(--size);
    height: var(--size);
    background: var(--screen-ink);
    -webkit-mask: var(--mask) 0 0 / 100% 100% no-repeat;
    mask: var(--mask) 0 0 / 100% 100% no-repeat;
  }
  @media (max-width: 700px) {
    .portrait { width: var(--size-sm); height: var(--size-sm); }
  }
</style>
