---
// Handheld.astro — the pure-CSS 3D handheld on the landing page.
// Port of handoff/reference/landing.html. The whole device is one link into
// the site; every control on it is decoration (aria-hidden).
import { getSiteData, getNow } from '../lib/content';

export interface Props {
  href: string;
}

const { href } = Astro.props;
const site = getSiteData();
const now = getNow();

const FACES = 13;
const [firstName, ...rest] = site.name.split(' ');
---
<div class="scale">
  <div class="settle">
    <div class="idle">
      <a class="device" href={href} aria-label={`Switch on the handheld and open ${site.name}'s site`}>

        {Array.from({ length: FACES }, (_, i) => (
          <span class={i === FACES - 1 ? 'face back' : 'face'} aria-hidden="true" style={`--i:${i}`}></span>
        ))}

        <span class="dev-bezel">
          <span class="dev-bar">
            <span class="dev-status">
              <span class="dev-led" aria-hidden="true"></span>
              <span class="dev-status-text">{now.working_on[0] ?? ''}</span>
            </span>
            <span class="dev-pin" aria-hidden="true"></span>
          </span>
          <span class="dev-lcd">
            <span class="dev-name">{site.name}</span>
            <span class="dev-tagline">{site.tagline}</span>
            <span class="dev-start">
              <span>Press start</span>
              <span class="dev-cursor blink" aria-hidden="true"></span>
            </span>
          </span>
        </span>

        <span class="dev-mark" aria-hidden="true"><small>{firstName.toLowerCase()}</small> {rest.join(' ')}</span>

        <span class="dev-controls" aria-hidden="true">
          <span class="dpad">
            <span class="arm up">Work</span>
            <span class="arm left">Notes</span>
            <span class="hub"></span>
            <span class="arm right">CV</span>
            <span class="arm down">Now</span>
          </span>
          <span class="ab">
            <span class="ab-btn b"><span class="dome">B</span><span class="ab-label">Back</span></span>
            <span class="ab-btn a"><span class="dome">A</span><span class="ab-label">Ask</span></span>
          </span>
        </span>

        <span class="dev-bottom" aria-hidden="true">
          <span class="lozenges">
            <span class="loz"><span class="loz-btn"></span><span class="loz-label">GitHub</span></span>
            <span class="loz"><span class="loz-btn"></span><span class="loz-label">Scholar</span></span>
          </span>
          <span class="speaker">
            {Array.from({ length: 6 }, () => <span class="slot"></span>)}
          </span>
        </span>

      </a>
    </div>
  </div>
</div>

<style>
  .scale { perspective: 1400px; perspective-origin: 50% 50%; }

  /* ── Motion: swivel loop + idle float ─────────────────────────────────── */
  @keyframes settle {
    0%, 12%  { transform: rotateY(-32deg) rotateX(8deg); }
    42%, 66% { transform: rotateY(0) rotateX(0); }
    100%     { transform: rotateY(-32deg) rotateX(8deg); }
  }
  .settle {
    transform: rotateY(-32deg) rotateX(8deg);
    animation: settle 10s cubic-bezier(.45, 0, .15, 1) infinite;
    transform-style: preserve-3d;
    will-change: transform;
  }
  .settle:hover, .settle:focus-within { animation-play-state: paused; }

  @keyframes idle {
    0%, 100% { transform: translateY(0); }
    50%      { transform: translateY(-8px); }
  }
  .idle { animation: idle 7s ease-in-out infinite; transform-style: preserve-3d; will-change: transform; }

  /* ── Body ─────────────────────────────────────────────────────────────── */
  .device {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 12px;
    width: 330px;
    height: 540px;
    padding: 18px 18px 22px;
    background-color: var(--shell);
    background-image: var(--shell-grain);
    border-radius: var(--radius-device);
    color: inherit;
    text-decoration: none;
    transform-style: preserve-3d;
  }
  .device:focus-visible { outline: 3px solid var(--print-blue); outline-offset: 6px; }

  /* 13 extrusion faces, lightest nearest the front; shadow on the back one. */
  .face {
    position: absolute;
    inset: 0;
    border-radius: var(--radius-device);
    pointer-events: none;
    background: color-mix(in srgb, var(--shell-edge-far) calc(var(--i) * 100% / 12), var(--shell-edge-near));
    transform: translateZ(calc(-4px * (var(--i) + 1)));
  }
  .face.back { box-shadow: 0 60px 70px rgba(30, 28, 24, .4); }

  /* ── Bezel + LCD ──────────────────────────────────────────────────────── */
  .dev-bezel {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 12px 14px 18px;
    background: var(--bezel);
    border-radius: 8px 8px 34px 8px;
    box-shadow: var(--bezel-bevel);
  }
  .dev-bar { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
  .dev-status {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-width: 0;
    font-family: var(--font-print);
    font-style: italic;
    font-weight: 600;
    font-size: 8px;
    letter-spacing: 0.06em;
    color: var(--print-blue-deep);
  }
  .dev-status-text { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 150px; }
  .dev-led { flex: 0 0 auto; width: 6px; height: 6px; border-radius: 50%; background: var(--led); }
  .dev-pin { flex: 1 1 60px; display: flex; flex-direction: column; gap: 2px; }
  .dev-pin::before, .dev-pin::after { content: ''; display: block; height: 2px; }
  .dev-pin::before { background: var(--magenta); }
  .dev-pin::after  { background: var(--print-blue); }

  .dev-lcd {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 10px;
    height: 190px;
    padding: 16px 18px;
    background: var(--screen);
    color: var(--screen-ink);
    border-radius: 4px;
    box-shadow: inset 0 0 0 4px var(--screen-edge), inset 0 8px 18px rgba(40, 42, 10, .22);
    transition: background-color .4s steps(3, end), box-shadow .4s, color .4s steps(3, end);
    view-transition-name: lcd;
  }
  .dev-name {
    font-family: var(--font-lcd);
    font-weight: 700;
    font-size: 24px;
    line-height: 1;
    text-shadow: 3px 3px 0 rgba(0, 0, 0, .12);
  }
  .dev-tagline { font-size: 11px; font-weight: 500; line-height: 1.4; max-width: 30ch; }
  .dev-start {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 6px;
    font-family: var(--font-lcd);
    font-size: 9px;
  }
  .dev-cursor { display: inline-block; width: 6px; height: 10px; background: currentColor; }

  /* Hover / focus: the screen powers on in three stepped frames. */
  .device:hover .dev-lcd,
  .device:focus-visible .dev-lcd {
    background: var(--screen-lit);
    color: var(--screen-lit-ink);
    box-shadow: inset 0 0 0 4px var(--screen-lit-edge), inset 0 8px 18px rgba(20, 40, 0, .25), 0 0 40px rgba(155, 188, 15, .35);
  }

  .dev-mark {
    padding: 0 4px;
    font-family: var(--font-print);
    font-style: italic;
    font-weight: 700;
    font-size: 15px;
    color: var(--print-blue);
  }
  .dev-mark small { font-weight: 500; font-size: 11px; }

  /* ── D-pad + A/B ──────────────────────────────────────────────────────── */
  .dev-controls { display: flex; align-items: center; justify-content: space-between; padding: 4px 4px 0; }

  .dpad {
    display: grid;
    grid-template-columns: repeat(3, 32px);
    grid-template-rows: repeat(3, 32px);
    filter: drop-shadow(0 3px 0 var(--pad-shadow));
  }
  .arm {
    display: flex;
    background-color: var(--pad);
    font-family: var(--font-lcd);
    font-size: 6px;
    color: var(--pad-label);
  }
  .up, .down { grid-column: 2; justify-content: center; background-image: repeating-linear-gradient(0deg, rgba(255,255,255,.07) 0 2px, transparent 2px 5px); }
  .left, .right { grid-row: 2; align-items: center; background-image: repeating-linear-gradient(90deg, rgba(255,255,255,.07) 0 2px, transparent 2px 5px); }
  .up    { grid-row: 1; align-items: flex-start; padding-top: 4px; border-radius: 4px 4px 0 0; }
  .down  { grid-row: 3; align-items: flex-end; padding-bottom: 4px; border-radius: 0 0 4px 4px; }
  .left  { grid-column: 1; justify-content: flex-start; padding-left: 4px; border-radius: 4px 0 0 4px; }
  .right { grid-column: 3; justify-content: flex-end; padding-right: 5px; border-radius: 0 4px 4px 0; }
  .hub   { grid-column: 2; grid-row: 2; background: radial-gradient(circle at 50% 45%, var(--pad-dimple) 0 7px, var(--pad) 8px); }

  .ab { display: flex; gap: 14px; align-items: flex-end; padding-right: 4px; transform: rotate(-12deg); }
  .ab-btn { display: flex; flex-direction: column; align-items: center; gap: 4px; }
  .ab-btn.b { transform: translateY(10px); }
  .dome {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 28%, var(--magenta-hi) 0, var(--magenta) 48%, var(--magenta-lo) 100%);
    box-shadow: 0 4px 0 var(--magenta-shadow), inset 0 -3px 0 rgba(0,0,0,.2), inset 0 2px 0 rgba(255,255,255,.18);
    font-family: var(--font-print);
    font-weight: 700;
    font-size: 17px;
    color: var(--magenta-letter);
    text-shadow: 0 1px 0 rgba(255,255,255,.22);
    transform: rotate(12deg);
  }
  .ab-label, .loz-label {
    font-family: var(--font-print);
    font-style: italic;
    font-weight: 700;
    font-size: 7px;
    letter-spacing: 0.08em;
    color: var(--print-blue);
  }

  /* ── Lozenges + speaker ───────────────────────────────────────────────── */
  .dev-bottom { display: flex; align-items: flex-end; justify-content: space-between; margin-top: auto; padding: 0 4px; }
  .lozenges { display: flex; gap: 14px; transform: translateX(40px); }
  .loz { display: flex; flex-direction: column; align-items: center; gap: 3px; }
  .loz-btn {
    display: block;
    width: 44px;
    height: 13px;
    border-radius: 999px;
    background: linear-gradient(180deg, var(--lozenge-hi) 0, var(--lozenge) 55%, var(--lozenge-lo) 100%);
    box-shadow: 0 2px 0 var(--lozenge-shadow), inset 0 1px 0 rgba(255,255,255,.4);
    transform: skewX(-14deg);
  }
  .speaker { display: flex; gap: 7px; padding-right: 6px; transform: rotate(-12deg); }
  .slot {
    display: block;
    width: 5px;
    height: 44px;
    border-radius: 3px;
    background: var(--speaker);
    box-shadow: inset 0 2px 3px rgba(0,0,0,.4), 0 1px 0 rgba(255,255,255,.35);
  }

  /* ── Preferences + small screens ──────────────────────────────────────── */
  @media (prefers-reduced-motion: reduce) {
    .idle, .blink { animation: none; }
  }

  /* Phones: face-on, no swivel, scaled to fit. */
  @media (max-width: 700px) {
    .settle { animation: none; transform: none; }
  }
  @media (max-width: 380px) { .scale { zoom: .9; } }
  @media (max-width: 340px) { .scale { zoom: .82; } }
  @media (max-height: 720px) and (min-width: 701px) { .scale { zoom: .82; } }
</style>
