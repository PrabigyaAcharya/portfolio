---
---
<footer class="site-footer" role="contentinfo">
  <div class="site-footer-inner">
    <div class="mcp-line">
      <span>§ this site speaks MCP —</span>
      <code>claude mcp add prabigya https://prabigya.com.np/mcp</code>
      <button type="button" class="copy-mcp" id="copy-mcp-footer" aria-label="Copy MCP command">[copy]</button>
    </div>
    <span style="font-size: 0.7em; color: var(--ink-ghost);">&copy; Prabigya Acharya</span>
  </div>
</footer>

<script>
  const btn = document.getElementById('copy-mcp-footer');
  btn?.addEventListener('click', () => {
    navigator.clipboard?.writeText('claude mcp add prabigya https://prabigya.com.np/mcp')
      .then(() => {
        if (btn) {
          btn.textContent = 'copied';
          setTimeout(() => { btn.textContent = '[copy]'; }, 1500);
        }
      });
  });
</script>
