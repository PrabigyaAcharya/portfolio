---
const navLinks = [
  { index: 0, href: '/', label: 'home' },
  { index: 1, href: '/research', label: 'research' },
  { index: 2, href: '/notebook', label: 'notebook' },
  { index: 3, href: '/now', label: 'now' },
  { index: 4, href: '/cv', label: 'cv' },
  { index: 5, href: '/colophon', label: 'colophon' },
];

const currentPath = Astro.url.pathname;
---

<header class="site-header" id="site-header" role="banner">
  <nav class="site-nav" aria-label="Site navigation">
    <span class="nav-keyword">contract</span>
    <span class="nav-name">Menu</span>
    <span class="nav-bracket">{'{'}</span>
    <ul class="nav-links">
      {navLinks.map(link => {
        const isActive = link.href === '/'
          ? currentPath === '/'
          : currentPath.startsWith(link.href);
        return (
          <li>
            <a
              href={link.href}
              class={`nav-link${isActive ? ' is-active' : ''}`}
              aria-current={isActive ? 'page' : undefined}
            >
              <span class="nav-idx">{`{${link.index}}`}</span>{link.label}
            </a>
          </li>
        );
      })}
    </ul>
    <span class="nav-bracket">{'}'}</span>
  </nav>
</header>

<script>
  const header = document.getElementById('site-header');
  window.addEventListener('scroll', () => {
    header?.classList.toggle('is-scrolled', window.scrollY > 80);
  }, { passive: true });
</script>
