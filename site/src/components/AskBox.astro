---
---
<div class="ask-box" id="ask-box">
  <span class="ask-label">// ask this notebook</span>
  <form class="ask-form" id="ask-form" action="mailto:acharyaprabigya@gmail.com" method="get">
    <div class="ask-terminal">
      <input
        type="text"
        id="ask-input"
        name="body"
        class="ask-input"
        placeholder="ask a question about this research…"
        maxlength="300"
        autocomplete="off"
        spellcheck="false"
        aria-label="Ask a question"
      />
      <button type="submit" class="ask-submit">ask →</button>
    </div>
  </form>
  <p class="ask-powered">
    powered by MCP &middot; or <a href="mailto:acharyaprabigya@gmail.com">email directly</a>
  </p>
  <div class="ask-answer" id="ask-answer" aria-live="polite" aria-atomic="true"></div>
</div>

<noscript>
  <p class="ask-noscript">
    JavaScript required for the ask-box. Use the <a href="/colophon#mcp-heading">MCP server</a> or <a href="mailto:acharyaprabigya@gmail.com">email directly</a>.
  </p>
</noscript>

<script>
  const form     = document.getElementById('ask-form') as HTMLFormElement | null;
  const input    = document.getElementById('ask-input') as HTMLInputElement | null;
  const answerEl = document.getElementById('ask-answer') as HTMLDivElement | null;
  if (!form || !input || !answerEl) throw new Error('ask-box elements missing');

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const question = input.value.trim();
    if (!question) return;

    answerEl.innerHTML = '';
    const block = document.createElement('div');
    block.className = 'ask-answer-block';
    const thinking = document.createElement('span');
    thinking.className = 'ask-thinking';
    thinking.textContent = 'thinking…';
    block.appendChild(thinking);
    answerEl.appendChild(block);

    try {
      const res = await fetch('/api/ask', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ question }),
      });

      const data = await res.json() as {
        answer?: string;
        sources?: string[];
        error?: string;
        mailto?: string;
      };

      block.innerHTML = '';

      if (data.error) {
        const errEl = document.createElement('p');
        errEl.className = 'ask-error';
        errEl.textContent = data.error;
        if (data.mailto) {
          errEl.textContent += ' ';
          const link = document.createElement('a');
          link.href = `mailto:${data.mailto}`;
          link.textContent = 'email directly';
          errEl.appendChild(link);
        }
        block.appendChild(errEl);
        return;
      }

      if (data.answer) {
        const answerText = document.createElement('p');
        answerText.className = 'ask-answer-text';
        answerText.textContent = data.answer;
        block.appendChild(answerText);

        if (data.sources && data.sources.length > 0) {
          const sourcesEl = document.createElement('p');
          sourcesEl.className = 'ask-sources';
          sourcesEl.textContent = data.sources.map((s: string) => `→ ${s}`).join('  ');
          block.appendChild(sourcesEl);
        }
      }
    } catch {
      block.innerHTML = '';
      const errEl = document.createElement('p');
      errEl.className = 'ask-error';
      errEl.textContent = 'could not reach the notebook right now.';
      block.appendChild(errEl);
    }
  });
</script>
