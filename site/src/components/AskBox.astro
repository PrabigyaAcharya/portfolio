---
// AskBox.astro — "ask this notebook". Without JS the form is a mailto;
// with JS it POSTs to /api/ask (the worker) and renders the grounded answer.
import { getSiteData } from '../lib/content';

const site = getSiteData();
const mailto = `mailto:${site.links.email}`;
---
<form class="ask-form" id="ask-form" action={mailto} method="get">
  <label for="ask-input" class="lcd-label">Your question</label>
  <input
    type="text"
    id="ask-input"
    name="body"
    class="lcd-input"
    placeholder="Type, then press Enter"
    maxlength="300"
    autocomplete="off"
    spellcheck="false"
  />
  <div class="btn-row">
    <button type="submit" class="lcd-btn">Ask</button>
    <a class="lcd-btn" href="/home">Back</a>
  </div>
</form>

<div class="ask-answer" id="ask-answer" aria-live="polite" aria-atomic="true"></div>

<p class="lcd-small">
  Powered by MCP · or <a href={mailto}>email directly</a>.
</p>

<noscript>
  <p class="lcd-small">
    Without JavaScript, Ask opens your mail client instead. Agents can use the
    <a href="/colophon#mcp-h2">MCP server</a>.
  </p>
</noscript>

<style>
  .ask-form { display: flex; flex-direction: column; gap: 12px; margin-top: 6px; }
  .ask-answer:empty { display: none; }
  .ask-answer { display: flex; flex-direction: column; gap: 10px; max-width: 64ch; }
  .ask-answer :global(.ask-status) { display: flex; align-items: center; gap: 8px; }
  .ask-answer :global(.ask-text) { font-size: 17px; line-height: 1.6; white-space: pre-line; }
  .ask-answer :global(.ask-sources) { display: flex; flex-wrap: wrap; gap: 4px 14px; }
</style>

<script>
  const form     = document.getElementById('ask-form') as HTMLFormElement | null;
  const input    = document.getElementById('ask-input') as HTMLInputElement | null;
  const answerEl = document.getElementById('ask-answer') as HTMLDivElement | null;
  if (!form || !input || !answerEl) throw new Error('ask-box elements missing');

  function el(tag: string, className: string, text?: string) {
    const node = document.createElement(tag);
    node.className = className;
    if (text) node.textContent = text;
    return node;
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const question = input.value.trim();
    if (!question) return;

    answerEl.replaceChildren();
    const status = el('p', 'lcd-label ask-status');
    status.append(el('span', '', 'Searching papers and notes'));
    const cursor = el('span', 'cursor blink');
    cursor.setAttribute('aria-hidden', 'true');
    status.append(cursor);
    answerEl.append(status);

    try {
      const res = await fetch('/api/ask', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ question }),
      });

      const data = await res.json() as {
        answer?: string;
        sources?: string[];
        error?: string;
        mailto?: string;
      };

      answerEl.replaceChildren();

      if (data.error) {
        const errEl = el('p', 'ask-text', data.error);
        if (data.mailto) {
          errEl.append(' ');
          const link = document.createElement('a');
          link.href = `mailto:${data.mailto}`;
          link.textContent = 'Email directly';
          errEl.append(link);
        }
        answerEl.append(errEl);
        return;
      }

      if (data.answer) {
        answerEl.append(el('p', 'ask-text ink-rule', data.answer));
        if (data.sources && data.sources.length > 0) {
          const sources = el('p', 'lcd-label ask-sources');
          data.sources.forEach(s => sources.append(el('span', '', `→ ${s}`)));
          answerEl.append(sources);
        }
      }
    } catch {
      answerEl.replaceChildren(el('p', 'ask-text', 'Could not reach the notebook right now.'));
    }
  });
</script>
