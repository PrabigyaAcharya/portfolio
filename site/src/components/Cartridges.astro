---
// Cartridges.astro — the drawer of game cartridges on the landing page. It is
// pinned to the window's right edge with only its handle showing, and slides
// open on hover or focus (or a tap on the handle, for touch). Pick a cartridge
// and its game boots on the handheld's screen; pick it again to stop. Games
// need JS, so without it the drawer never shows.
import { cartridges } from '../games/cartridges';

// 8×8 pixel glyphs for the labels, as ink rects.
const glyphs: Record<string, Array<[number, number, number, number]>> = {
  // A dip in a curve with the ball resting in it.
  'descent': [[0, 1, 1, 2], [1, 3, 1, 2], [2, 5, 1, 1], [3, 6, 2, 1], [5, 5, 1, 1], [6, 3, 1, 2], [7, 2, 1, 1], [3, 4, 2, 2]],
  // A chain of tokens turning a corner.
  'context-window': [[0, 1, 2, 2], [3, 1, 2, 2], [6, 1, 2, 2], [6, 4, 2, 2], [6, 7, 2, 1], [0, 5, 3, 1], [1, 6, 1, 1]],
  // Pages stacked, the top one offset.
  'camera-ready': [[2, 0, 5, 1], [1, 2, 6, 1], [1, 4, 6, 1], [1, 6, 6, 1], [1, 7, 6, 1]],
};
---
<div class="drawer" data-shelf hidden>
  <button class="drawer-handle" type="button" aria-expanded="false" aria-controls="cartridge-list">Cartridges</button>
  <div class="drawer-body" id="cartridge-list">
    <ul class="shelf-list">
      {cartridges.map(c => (
        <li>
          <button class="cart" type="button" data-cart={c.id} data-title={c.title} aria-pressed="false" aria-label={`${c.title}: ${c.labelLine}`}>
            <span class="cart-label" aria-hidden="true">
              <span class="cart-stripe"></span>
              <svg class="cart-glyph" viewBox="0 0 8 8" shape-rendering="crispEdges" focusable="false">
                {glyphs[c.id]?.map(([x, y, w, h]) => <rect x={x} y={y} width={w} height={h} />)}
              </svg>
              <span class="cart-title">{c.title}</span>
              <span class="cart-line">{c.labelLine}</span>
            </span>
          </button>
        </li>
      ))}
    </ul>
    <p class="shelf-hint">Pick one to play,<br />again to stop</p>
  </div>
</div>

<script>
  import { findCartridge } from '../games/cartridges';
  import { mountGame, type Mounted } from '../games/runtime';
  import { Pad, bindKeys, bindButtons } from '../games/input';
  import { getInserted, setInserted } from '../games/state';
  import type { Key } from '../games/types';

  const drawer = document.querySelector<HTMLElement>('[data-shelf]');
  const scale = document.querySelector<HTMLElement>('.scale');
  const device = scale?.querySelector<HTMLElement>('.device');

  if (drawer && scale && device) {
    const handle = drawer.querySelector<HTMLButtonElement>('.drawer-handle')!;
    const lcd = device.querySelector<HTMLElement>('.dev-lcd')!;
    const canvas = device.querySelector<HTMLCanvasElement>('.dev-game')!;
    const link = device.querySelector<HTMLAnchorElement>('.device-link')!;
    const status = device.querySelector<HTMLElement>('[data-preview-status]')!;
    const carts = Array.from(drawer.querySelectorAll<HTMLButtonElement>('.cart'));
    const pad = new Pad();

    const controls: Array<[string, Key]> = [
      ['.arm.up', 'up'], ['.arm.down', 'down'], ['.arm.left', 'left'], ['.arm.right', 'right'],
      ['.ab-btn.a', 'a'], ['.ab-btn.b', 'start'],
    ];

    let current: { id: string; cart: HTMLButtonElement; game?: Mounted; unbind: () => void } | null = null;

    const setOpen = (open: boolean) => {
      drawer.classList.toggle('open', open);
      handle.setAttribute('aria-expanded', String(open));
    };
    handle.addEventListener('click', () => setOpen(!drawer.classList.contains('open')));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && drawer.classList.contains('open')) setOpen(false); });

    function stop() {
      if (!current) return;
      const { cart, game, unbind } = current;
      current = null;
      game?.stop();
      unbind();
      lcd.classList.remove('playing', 'boot');
      canvas.hidden = true;
      link.inert = false;
      scale!.classList.remove('has-cart');
      cart.setAttribute('aria-pressed', 'false');
      status.textContent = `${cart.dataset.title} stopped.`;
    }

    async function select(cart: HTMLButtonElement, fromUser: boolean) {
      const id = cart.dataset.cart!;
      const title = cart.dataset.title!;
      if (!findCartridge(id)) return;
      if (current?.id === id) { stop(); setInserted(null); return; }
      stop();

      cart.setAttribute('aria-pressed', 'true');
      scale!.classList.add('has-cart');
      // Hand the controls to the game.
      link.inert = true;
      const unbindButtons = bindButtons(pad, controls.map(([sel, k]) => [device!.querySelector<HTMLElement>(sel)!, k]));
      // Enter and Space keep their usual meaning on focused links and buttons.
      const unbindKeys = bindKeys(pad, (e) => !((e.key === 'Enter' || e.key === ' ')
        && e.target instanceof HTMLElement && e.target.closest('a, button')));
      current = { id, cart, unbind: () => { unbindButtons(); unbindKeys(); } };

      lcd.classList.add('playing', 'boot');
      canvas.hidden = false;
      canvas.tabIndex = -1;
      canvas.setAttribute('aria-label', `${title} game screen`);
      setTimeout(() => lcd.classList.remove('boot'), 400);
      setInserted(id);
      status.textContent = `${title} selected. Press Start to play: arrow keys or the d-pad to move, Z or A for action.`;

      if (fromUser) {
        setOpen(false);
        // On phones the drawer sits below the device; bring the screen into view.
        const r = lcd.getBoundingClientRect();
        if (r.top < 0 || r.bottom > window.innerHeight) lcd.scrollIntoView({ block: 'center' });
        canvas.focus({ preventScroll: true });
      }

      try {
        const game = await mountGame(canvas, id, { mode: 'play', pad });
        if (current?.id === id) current.game = game; else game.stop();
      } catch { /* nothing to run; the screen stays blank */ }
    }

    for (const cart of carts) cart.addEventListener('click', () => select(cart, true));

    // The cartridge picked last visit is still selected.
    const remembered = carts.find(c => c.dataset.cart === getInserted());
    if (remembered) select(remembered, false);

    drawer.hidden = false;
  }
</script>

<style is:global>
  /* ── Cartridge ──────────────────────────────────────────────────────────── */
  .cart {
    position: relative;
    display: flex;
    flex-direction: column;
    width: 92px;
    height: 104px;
    padding: 16px 8px 12px;
    border: 0;
    border-radius: 6px 6px 3px 3px;
    background-color: var(--shell);
    background-image:
      repeating-linear-gradient(180deg, var(--shell-edge-far) 0 2px, transparent 2px 4px),
      var(--shell-grain);
    background-size: 100% 12px, auto;
    background-repeat: no-repeat, repeat;
    background-position: 0 2px, 0 0;
    box-shadow: 0 4px 0 var(--shell-edge-far), inset 0 -2px 0 var(--shell-edge-near);
    font: inherit;
    color: var(--screen-ink);
    text-align: left;
  }
  /* Contacts along the bottom edge. */
  .cart::after {
    content: '';
    position: absolute;
    left: 14px;
    right: 14px;
    bottom: 3px;
    height: 4px;
    background: repeating-linear-gradient(90deg, var(--shell-edge-far) 0 3px, transparent 3px 5px);
  }
  .cart-label {
    display: flex;
    flex-direction: column;
    gap: 4px;
    flex: 1 1 auto;
    padding: 5px 6px 6px;
    background: var(--screen);
    color: var(--screen-ink);
    border-radius: 2px;
    box-shadow: inset 0 0 0 2px var(--screen-edge);
    transition: background-color var(--invert), color var(--invert);
  }
  .cart-stripe { display: flex; flex-direction: column; gap: 1px; }
  .cart-stripe::before, .cart-stripe::after { content: ''; display: block; height: 2px; }
  .cart-stripe::before { background: var(--magenta); }
  .cart-stripe::after  { background: var(--print-blue); }
  .cart-glyph { width: 16px; height: 16px; fill: currentColor; }
  .cart-title { font-family: var(--font-lcd); font-weight: 700; font-size: 8px; line-height: 1.15; }
  .cart-line { font-size: 8px; font-weight: 600; line-height: 1.2; }

  /* Hover and the selected cartridge invert the label, like an LCD control. */
  .cart:hover .cart-label,
  .cart:focus-visible .cart-label,
  .cart[aria-pressed='true'] .cart-label { background: var(--screen-ink); color: var(--screen); }
  .cart[aria-pressed='true'] { outline: 3px solid var(--print-blue); outline-offset: 3px; }
  .cart:focus-visible { outline: 3px solid var(--print-blue); outline-offset: 3px; }

  /* ── Drawer ─────────────────────────────────────────────────────────────── */
  /* Pinned to the right edge with only the handle showing; it slides open on
     hover, keyboard focus or a tap on the handle. */
  .drawer {
    --handle: 34px;
    position: fixed;
    right: 0;
    top: 50%;
    z-index: 5;
    display: flex;
    align-items: center;
    transform: translate(calc(100% - var(--handle)), -50%);
    transition: transform .32s cubic-bezier(.2, .8, .2, 1);
  }
  .drawer[hidden] { display: none; }
  .drawer:hover,
  .drawer:focus-within,
  .drawer.open { transform: translate(0, -50%); }
  /* Closed, the tray is hidden once it has slid away: no edge peeking past
     the window, and its cartridges leave the tab order (the handle stays). */
  .drawer-body { transition: visibility 0s .32s; }
  .drawer:not(:hover, :focus-within, .open) .drawer-body { visibility: hidden; }
  .drawer:is(:hover, :focus-within, .open) .drawer-body { visibility: visible; transition: none; }

  .drawer-handle {
    flex: 0 0 var(--handle);
    align-self: center;
    padding: 18px 0;
    border: 0;
    border-radius: 10px 0 0 10px;
    background-color: var(--shell);
    background-image: var(--shell-grain);
    box-shadow: inset 2px 0 0 var(--shell-edge-near), -3px 0 0 var(--shell-edge-far);
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    font-family: var(--font-print);
    font-style: italic;
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 0.06em;
    color: var(--print-blue);
  }
  .drawer-handle:focus-visible { outline: 3px solid var(--print-blue); outline-offset: 2px; }

  .drawer-body {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    padding: 20px 22px 18px;
    background-color: var(--shell);
    background-image: var(--shell-grain);
    border-radius: 0 0 0 16px;
    box-shadow: -3px 0 0 var(--shell-edge-far), inset 0 0 0 2px var(--shell-edge-near);
  }
  .shelf-list { display: flex; flex-direction: column; gap: 20px; margin: 0; padding: 0; list-style: none; }
  .shelf-hint {
    margin: 0;
    font-family: var(--font-print);
    font-style: italic;
    font-weight: 700;
    font-size: 11px;
    letter-spacing: 0.04em;
    text-align: center;
    color: var(--print-blue);
  }

  @media (prefers-reduced-motion: reduce) {
    .drawer { transition: none; }
  }

  /* Phones: no hover and no room at the edge, so the drawer sits below the
     device and the handle opens it. */
  @media (max-width: 700px) {
    .drawer {
      position: static;
      transform: none !important;
      flex-direction: column;
      gap: 0;
    }
    .drawer-handle {
      writing-mode: horizontal-tb;
      transform: none;
      padding: 8px 22px;
      border-radius: 10px 10px 0 0;
      box-shadow: inset 0 2px 0 var(--shell-edge-near), 0 -3px 0 var(--shell-edge-far);
    }
    .drawer-body { display: none; border-radius: 10px; }
    .drawer.open .drawer-body { display: flex; }
    .shelf-list { flex-direction: row; gap: 14px; }
  }
  @media (max-width: 360px) { .shelf-list { zoom: .9; } }
</style>
