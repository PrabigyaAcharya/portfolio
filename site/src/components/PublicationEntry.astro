---
export interface Props {
  pub: {
    id: string;
    title: string;
    authors: string[];
    venue: string;
    year: number;
    summary: string;
    abstract?: string;
    backstory?: string;
    links?: {
      pdf?: string;
      arxiv?: string;
      code?: string;
      poster?: string;
    };
    bibtex?: string;
    selected?: boolean;
  };
}

const { pub } = Astro.props;
const bibtexJson = pub.bibtex ? JSON.stringify(pub.bibtex) : 'null';

const links = [
  { label: 'PDF',    href: pub.links?.pdf },
  { label: 'arXiv',  href: pub.links?.arxiv },
  { label: 'Code',   href: pub.links?.code },
  { label: 'Poster', href: pub.links?.poster },
].filter((l): l is { label: string; href: string } => !!l.href && l.href.length > 0);
---

<article class="pub" id={pub.id}>
  <h3 class="pub-title">{pub.title}</h3>
  <p class="pub-meta">
    <span>{pub.authors.join(', ')}</span>
    <span>{pub.venue}, {pub.year}</span>
  </p>
  {pub.backstory && <p class="lcd-small">{pub.backstory}</p>}

  <div class="btn-row pub-actions">
    {pub.abstract && (
      <details class="pub-details">
        <summary class="lcd-btn">Abstract</summary>
        <p class="pub-panel ink-rule">{pub.abstract}</p>
      </details>
    )}
    {pub.bibtex && (
      <details class="pub-details">
        <summary class="lcd-btn">BibTeX</summary>
        <div class="pub-panel">
          <pre><code>{pub.bibtex}</code></pre>
          <button type="button" class="lcd-btn copy-bibtex-btn" data-bibtex={bibtexJson}>Copy</button>
        </div>
      </details>
    )}
    {links.map(l => (
      <a class="lcd-btn" href={l.href} target="_blank" rel="noopener noreferrer">{l.label}</a>
    ))}
  </div>
</article>

<style>
  .pub { display: flex; flex-direction: column; gap: 12px; }
  .pub-title { font-size: clamp(20px, 2vw, 26px) !important; line-height: 1.25; max-width: 44ch; text-wrap: balance; }
  .pub-meta { display: flex; flex-wrap: wrap; gap: 6px 18px; font-size: 15px; }

  /* An open panel takes its own full-width line after the closed buttons. */
  .pub-actions { align-items: flex-start; }
  .pub-details[open] { order: 10; flex: 1 0 100%; display: flex; flex-direction: column; align-items: flex-start; gap: 10px; }
  .pub-panel { margin: 0; max-width: 68ch; font-size: 15px; line-height: 1.6; }
  .pub-panel pre { margin: 0 0 8px; font-size: 13px; white-space: pre-wrap; word-break: break-word; }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('.copy-bibtex-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const bibtex = btn.dataset.bibtex ? JSON.parse(btn.dataset.bibtex) as string : '';
      navigator.clipboard?.writeText(bibtex).then(() => {
        btn.textContent = 'Copied';
        setTimeout(() => { btn.textContent = 'Copy'; }, 1500);
      });
    });
  });
</script>
