---
import Screen from '../layouts/Screen.astro';
---
<Screen title="Not found">
  <div class="view lost">
    <h1 class="lcd-display">404</h1>
    <p class="lcd-lede">This page isn't in the notebook.</p>
    <div class="btn-row">
      <a class="lcd-btn" href="/home">Home</a>
      <a class="lcd-btn" href="/notebook">Notebook</a>
      <a class="lcd-btn" href="/research">Research</a>
    </div>
  </div>
</Screen>

<style>
  .lost { flex: 1 1 auto; justify-content: center; gap: 24px; }
</style>
