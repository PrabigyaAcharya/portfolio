---
import Screen from '../layouts/Screen.astro';
import AskBox from '../components/AskBox.astro';
import { getSiteData } from '../lib/content';

const site = getSiteData();
---
<Screen title="Ask" description={`Ask questions about ${site.name}: research, papers, work, CV, notes`} active="ask">
  <div class="view ask-view">
    <h1>Ask anything about me</h1>
    <p class="lcd-small">
      My research, papers, work, CV, what I'm doing now, the notebook: answers come
      from this site and nothing else, and link to the pages they came from.
    </p>
    <AskBox />
  </div>
</Screen>

<style>
  .ask-view { max-width: 640px; gap: 12px; }
</style>
