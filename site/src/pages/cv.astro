---
import Screen from '../layouts/Screen.astro';
import { getCV, getSiteData, getPublications, type CVEntry } from '../lib/content';

const cv = getCV();
const site = getSiteData();
const publications = getPublications();

const handle = (url: string) => url.replace(/^https?:\/\//, '').replace(/\/$/, '').split('/').pop() ?? url;
const linkedinHref = site.links.linkedin.startsWith('http') ? site.links.linkedin : `https://${site.links.linkedin}`;
const dates = (e: CVEntry) => e.start === e.end ? e.start : `${e.start}–${e.end}`;

const elsewhere = [
  ...(site.links.cv_pdf ? [{ label: 'Curriculum vitae', meta: 'PDF', href: site.links.cv_pdf, download: true }] : []),
  { label: 'GitHub',           meta: handle(site.links.github),    href: site.links.github },
  { label: 'Google Scholar',   meta: 'Citations',                  href: site.links.scholar },
  { label: 'LinkedIn',         meta: handle(linkedinHref),         href: linkedinHref },
  { label: 'Email',            meta: site.links.email,             href: `mailto:${site.links.email}` },
  { label: 'Colophon',         meta: 'How this site is made',      href: '/colophon' },
];

// Sections in the same order as the PDF.
type Block =
  | { kind: 'entries'; title: string; entries: CVEntry[] }
  | { kind: 'publications'; title: string }
  | { kind: 'list'; title: string; items: string[] }
  | { kind: 'certifications'; title: string };
const blocks: Block[] = [
  { kind: 'entries', title: 'Education', entries: cv.education },
  { kind: 'entries', title: 'Research and work experience', entries: cv.positions },
  { kind: 'publications', title: 'Publications' },
  { kind: 'entries', title: 'Grants and funded research', entries: cv.grants },
  { kind: 'entries', title: 'Research supervision and mentorship', entries: cv.supervision },
  { kind: 'list', title: 'Technical skills', items: cv.skills },
  { kind: 'certifications', title: 'Certifications and programs' },
  { kind: 'entries', title: 'Teaching, volunteering and leadership', entries: cv.teaching },
  { kind: 'list', title: 'Service', items: cv.service },
  { kind: 'list', title: 'Awards', items: cv.awards },
];
const isEmpty = (b: Block) =>
  b.kind === 'entries' ? b.entries.length === 0
  : b.kind === 'list' ? b.items.length === 0
  : b.kind === 'publications' ? publications.length === 0
  : cv.certifications.length === 0;
---
<Screen title="CV" description={`Curriculum vitae of ${site.name}`} active="cv">
  <div class="view">
    <h1>CV and elsewhere</h1>
    {cv.summary && <p class="lcd-lede cv-summary">{cv.summary}</p>}

    <ul class="lcd-rows">
      {elsewhere.map(l => (
        <li>
          <a class="lcd-row" href={l.href} download={l.download ? '' : undefined}>
            <span class="row-title">{l.label}</span>
            <span class="row-meta">{l.meta}</span>
          </a>
        </li>
      ))}
    </ul>

    {blocks.filter(b => !isEmpty(b)).map(b => (
      <section class="section">
        <h2>{b.title}</h2>
        {b.kind === 'entries' && (
          <div>
            {b.entries.map(entry => (
              <div class="cv-entry">
                <div class="cv-entry-dates">{dates(entry)}</div>
                <div>
                  <div class="cv-entry-org">{entry.role}</div>
                  <div class="cv-entry-role">{entry.org}</div>
                  {entry.note && <div class="cv-entry-note">{entry.note}</div>}
                  {entry.details && entry.details.length > 0 && (
                    <ul class="cv-entry-details">{entry.details.map(d => <li>{d}</li>)}</ul>
                  )}
                </div>
              </div>
            ))}
          </div>
        )}
        {b.kind === 'publications' && (
          <div>
            {publications.map(pub => (
              <div class="cv-entry">
                <div class="cv-entry-dates">{pub.year}</div>
                <div>
                  <div class="cv-entry-org">{pub.title}</div>
                  <div class="cv-entry-role">{pub.authors.join(', ')}</div>
                  <div class="cv-entry-note">{pub.venue}</div>
                </div>
              </div>
            ))}
          </div>
        )}
        {b.kind === 'list' && <ul class="ink-list">{b.items.map(item => <li>{item}</li>)}</ul>}
        {b.kind === 'certifications' && (
          <ul class="ink-list">
            {cv.certifications.map(c => (
              <li>
                <strong>{c.title}.</strong> {c.detail}
                {c.link && <> <a href={c.link}>Certificate</a></>}
              </li>
            ))}
          </ul>
        )}
      </section>
    ))}
  </div>
</Screen>

<style>
  .cv-summary { max-width: 60ch; }
  .cv-entry-note { font-size: 15px; font-style: italic; }
</style>
