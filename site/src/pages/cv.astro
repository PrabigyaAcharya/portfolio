---
import Page from '../layouts/Page.astro';
import { getCV, getSiteData, getPublications } from '../lib/content';

const cv = getCV();
const site = getSiteData();
const publications = getPublications();
---
<Page title="CV" description={`Curriculum vitae of ${site.name}`}>
  <div class="cv-page-header">
    <h1>{site.name}</h1>
    <a href="/prabigya-acharya-cv.pdf" class="mono" style="font-size: 0.72em; color: var(--accent);" download>[download pdf]</a>
  </div>

  <!-- Education -->
  <section aria-labelledby="education-heading" class="page-section">
    <h2 id="education-heading" class="section-label">education</h2>
    <div>
      {cv.education.map(entry => (
        <div class="cv-entry">
          <div class="cv-entry-dates">{entry.start}–{entry.end}</div>
          <div class="cv-entry-body">
            <div class="cv-entry-org">{entry.org}</div>
            <div class="cv-entry-role">{entry.role}</div>
            {entry.details && entry.details.length > 0 && (
              <ul class="cv-entry-details">
                {entry.details.map(d => <li>{d}</li>)}
              </ul>
            )}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Positions -->
  <section aria-labelledby="positions-heading" class="page-section">
    <h2 id="positions-heading" class="section-label">positions</h2>
    <div>
      {cv.positions.map(entry => (
        <div class="cv-entry">
          <div class="cv-entry-dates">{entry.start}–{entry.end}</div>
          <div class="cv-entry-body">
            <div class="cv-entry-org">{entry.org}</div>
            <div class="cv-entry-role">{entry.role}</div>
            {entry.details && entry.details.length > 0 && (
              <ul class="cv-entry-details">
                {entry.details.map(d => <li>{d}</li>)}
              </ul>
            )}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Publications -->
  <section aria-labelledby="pubs-heading" class="page-section">
    <h2 id="pubs-heading" class="section-label">publications</h2>
    <div>
      {publications.map(pub => (
        <div class="cv-entry">
          <div class="cv-entry-dates">{pub.year}</div>
          <div class="cv-entry-body">
            <div class="cv-entry-org" style="font-size: 0.95rem;">{pub.title}</div>
            <div class="cv-entry-role">{pub.authors.join(', ')} · {pub.venue}</div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Skills -->
  <section aria-labelledby="skills-heading" class="page-section">
    <h2 id="skills-heading" class="section-label">skills</h2>
    <ul style="list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 0.25rem;">
      {cv.skills.map(skill => (
        <li style="font-size: 0.88rem; color: var(--ink-soft); padding: 0.15rem 0.6rem; border: 1px solid var(--rule);">{skill}</li>
      ))}
    </ul>
  </section>

  <!-- Service -->
  <section aria-labelledby="service-heading" class="page-section">
    <h2 id="service-heading" class="section-label">service</h2>
    <ul class="now-list">
      {cv.service.map(item => <li>{item}</li>)}
    </ul>
  </section>

  <!-- Awards -->
  <section aria-labelledby="awards-heading" class="page-section">
    <h2 id="awards-heading" class="section-label">awards</h2>
    <ul class="now-list">
      {cv.awards.map(item => <li>{item}</li>)}
    </ul>
  </section>

  <div slot="margin">
    <div class="margin-note" style="margin-top: 5rem;">
      <span class="margin-stamp">pdf note</span>
      PDF generated from the same data as this page via Typst.
    </div>
  </div>
</Page>
