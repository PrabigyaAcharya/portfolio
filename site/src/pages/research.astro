---
import Page from '../layouts/Page.astro';
import PublicationEntry from '../components/PublicationEntry.astro';
import { getSiteData, getPublicationsByYear } from '../lib/content';

const site = getSiteData();
const byYear = getPublicationsByYear();
const years = [...byYear.keys()];
---
<Page title="Research" description={`Research and publications by ${site.name}`}>
  <section class="page-intro">
    <h1>Research</h1>
    <p class="page-lede">
      I work on privacy-preserving NLP and 3D computer vision — from lightweight models for PII masking in conversational text, to Gaussian splatting pipelines for digitizing cultural heritage.
    </p>
  </section>

  <div>
    {years.map((year, i) => (
      <details class="year-accordion" open={i === 0}>
        <summary class="year-summary">
          <span class="year-toggle"></span>
          <span class="year-label">{year}</span>
        </summary>
        <div class="year-body">
          {byYear.get(year)!.map(pub => (
            <PublicationEntry pub={pub} />
          ))}
        </div>
      </details>
    ))}
  </div>

  <div slot="margin">
    <div class="margin-note" style="margin-top: 4rem;">
      <span class="margin-stamp">threads</span>
      {site.research_threads.map(thread => (
        <p style="margin-bottom: 0.75rem; font-style: normal; font-size: 0.9em;">{thread.name}</p>
      ))}
    </div>
  </div>
</Page>
