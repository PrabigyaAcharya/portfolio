---
import Screen from '../layouts/Screen.astro';
import PublicationEntry from '../components/PublicationEntry.astro';
import { getSiteData, getPublicationsByYear } from '../lib/content';

const site = getSiteData();
const byYear = getPublicationsByYear();
const years = [...byYear.keys()];
const threads = site.research_threads ?? [];
---
<Screen title="Research" description={`Research and publications by ${site.name}`} active="research">
  <div class="view">
    <h1>Selected work</h1>
    <p class="lcd-small">
      I work on privacy-preserving NLP and 3D computer vision — from lightweight models
      for PII masking in conversational text, to Gaussian splatting pipelines for
      digitising cultural heritage.
    </p>

    {threads.length > 0 && (
      <ul class="ink-list threads">
        {threads.map(t => (
          <li><span class="lcd-label">{t.name}</span><br /><span class="lcd-small">{t.blurb}</span></li>
        ))}
      </ul>
    )}

    {years.map(year => (
      <section class="section year" aria-label={String(year)}>
        <h2 class="lcd-label year-label">{year}</h2>
        {byYear.get(year)!.map(pub => <PublicationEntry pub={pub} />)}
      </section>
    ))}

    <div class="btn-row">
      <a class="lcd-btn" href={site.links.scholar}>All publications</a>
      <a class="lcd-btn" href="/research.md">Markdown</a>
    </div>
  </div>
</Screen>

<style>
  .threads { margin-bottom: 8px; }
  .year { margin-top: 8px; }
  .year-label { font-size: 12px !important; }
</style>
