---
import Screen from '../layouts/Screen.astro';
import { getSiteData } from '../lib/content';
import Portrait from '../components/Portrait.astro';

const site = getSiteData();
---
<Screen title="Home" description={site.tagline} active="home">
  <div class="view home-view">
    <div class="home-id">
      <Portrait size={192} small={128} />
      <h1 class="lcd-display">{site.name}</h1>
    </div>
    <p class="lcd-lede">{site.tagline}.</p>
    <p class="lcd-label home-hint">
      <span>Arrow keys to browse. Enter to ask a question.</span>
      <span class="cursor blink" aria-hidden="true"></span>
    </p>
  </div>
</Screen>

<style>
  .home-view { flex: 1 1 auto; justify-content: center; gap: 24px; padding: 8px 0; }
  .home-id { display: flex; align-items: center; gap: 32px; }
  @media (max-width: 700px) {
    .home-id { flex-direction: column; align-items: flex-start; gap: 16px; }
  }
  .home-hint { display: flex; align-items: center; gap: 8px; margin-top: 8px; font-size: 12px; }
</style>
