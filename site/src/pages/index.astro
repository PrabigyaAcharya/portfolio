---
import Page from '../layouts/Page.astro';
import PublicationEntry from '../components/PublicationEntry.astro';
import AskBox from '../components/AskBox.astro';
import { getSiteData, getSelectedPublications, getNow } from '../lib/content';
import { getCollection } from 'astro:content';

const site = getSiteData();
const selected = getSelectedPublications();
const now = getNow();

const allPosts = await getCollection('notebook', ({ data }) => !data.draft);
const recentPosts = allPosts
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

interface LabSnapshot {
  status: string;
  received_at: string | null;
  latest?: {
    run_name?: string;
    epoch?: number;
    total_epochs?: number;
    loss?: number;
  } | null;
}

const labSnapshot: LabSnapshot = { status: 'idle', received_at: null, latest: null };
---
<Page title={site.name} description={site.tagline} breadcrumb={[]}>
  <!-- Hero -->
  <section class="page-intro">
    <span class="hero-tag">prabigya =v1.0;</span>
    <h1 class="hero-title">{site.name}</h1>
    <p class="page-lede">{site.tagline}</p>
    <p style="font-size: 0.72em; color: var(--ink-ghost); margin-top: 0.75rem;">
      now: {now.working_on[0] ?? '…'}
    </p>
    <div
      class="telemetry-strip"
      data-poll="/api/lab.json"
      data-status={labSnapshot.status}
    >
      <span class="telemetry-label">lab</span>
      <span class="telemetry-status" data-field="status">
        {labSnapshot.status === 'training' ? 'training' : 'idle'}
      </span>
      {labSnapshot.status === 'training' && labSnapshot.latest?.run_name && (
        <span class="telemetry-detail" data-field="run_name">{labSnapshot.latest.run_name}</span>
      )}
      {labSnapshot.status === 'training' && labSnapshot.latest?.loss !== undefined && (
        <span class="telemetry-detail" data-field="loss">loss {labSnapshot.latest.loss.toFixed(4)}</span>
      )}
      {labSnapshot.status === 'training' && labSnapshot.latest?.epoch !== undefined && labSnapshot.latest?.total_epochs !== undefined && (
        <span class="telemetry-detail" data-field="epoch">epoch {labSnapshot.latest.epoch}/{labSnapshot.latest.total_epochs}</span>
      )}
    </div>
  </section>

  <!-- Selected work -->
  {selected.length > 0 && (
    <section class="page-section">
      <span class="code-comment">// selected work</span>
      <h2 class="code-heading">selected_work <span class="code-brace">{'{'}</span></h2>
      <div class="code-body">
        {selected.map(pub => (
          <PublicationEntry pub={pub} />
        ))}
        <p style="margin-top: 1rem;">
          <a href="/research" style="font-size: 0.82em;">all publications →</a>
        </p>
      </div>
      <span class="code-close code-brace">{'}'}</span>
    </section>
  )}

  <!-- Recent notebook -->
  {recentPosts.length > 0 && (
    <section class="page-section">
      <span class="code-comment">// recent writing</span>
      <h2 class="code-heading">notebook <span class="code-brace">{'{'}</span></h2>
      <div class="code-body">
        <ul class="post-list" role="list">
          {recentPosts.map(post => (
            <li class="post-list-item entry-list-item">
              <div>
                <a href={`/notebook/${post.slug}`} class="post-title" style="text-decoration: none;">
                  {post.data.title}
                </a>
                <p class="post-summary">{post.data.summary}</p>
              </div>
              <time class="post-meta" datetime={post.data.date.toISOString()}>
                {post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
              </time>
            </li>
          ))}
        </ul>
        <p style="margin-top: 1rem;">
          <a href="/notebook" style="font-size: 0.82em;">all posts →</a>
        </p>
      </div>
      <span class="code-close code-brace">{'}'}</span>
    </section>
  )}

  <!-- Ask box -->
  <section class="page-section">
    <span class="code-comment">// ask this notebook</span>
    <AskBox />
  </section>

  <div slot="margin">
    <div class="margin-note" style="margin-top: 8rem;">
      <span class="margin-stamp">location</span>
      {site.location}
    </div>
    <div class="margin-note" style="margin-top: 1.5rem;">
      <span class="margin-stamp">research</span>
      {site.research_threads.map(t => (
        <p style="margin-bottom: 0.5rem; font-style: normal; font-size: 0.9em; color: var(--ink-faint);">{t.name}</p>
      ))}
    </div>
  </div>
</Page>
