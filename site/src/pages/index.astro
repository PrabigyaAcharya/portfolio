---
import Page from '../layouts/Page.astro';
import PublicationEntry from '../components/PublicationEntry.astro';
import AskBox from '../components/AskBox.astro';
import { getSiteData, getSelectedPublications, getNow } from '../lib/content';
import { getCollection } from 'astro:content';

const site = getSiteData();
const selected = getSelectedPublications();
const now = getNow();

const allPosts = await getCollection('notebook', ({ data }) => !data.draft);
const recentPosts = allPosts
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);
---
<Page title={site.name} description={site.tagline} breadcrumb={[]}>

  <!-- Hero -->
  <section class="hero-block" style="margin-bottom: 0;">
    <span class="hero-version">prabigya =v1.0;</span>
    <h1 class="hero-title">{site.name}</h1>
    <p class="hero-tagline">{site.tagline}</p>
    <span class="hero-now">now: {now.working_on[0] ?? '…'}</span>
    <div class="lab-status" data-poll="/api/lab.json" data-status="idle">
      <span class="lab-dot"></span>
      lab <span data-field="status">idle</span>
    </div>
  </section>

  <!-- Ask this notebook -->
  <AskBox />

  <!-- Selected work -->
  {selected.length > 0 && (
    <section class="page-section">
      <span class="code-comment">// selected work</span>
      <h2 class="code-heading">selected_work <span class="code-brace">{'{'}</span></h2>
      <div class="code-body">
        {selected.map(pub => <PublicationEntry pub={pub} />)}
        <p style="margin-top: 0.5rem;">
          <a href="/research" style="font-family: var(--font-mono); font-size: 0.8rem;">all publications →</a>
        </p>
      </div>
      <span class="code-close">{'}'}</span>
    </section>
  )}

  <!-- Recent notebook -->
  {recentPosts.length > 0 && (
    <section class="page-section">
      <span class="code-comment">// recent writing</span>
      <h2 class="code-heading">notebook <span class="code-brace">{'{'}</span></h2>
      <div class="code-body">
        <ul class="post-list" role="list">
          {recentPosts.map(post => (
            <li class="post-list-item entry-list-item">
              <div class="post-row">
                <a href={`/notebook/${post.slug}`} class="post-title-link">
                  {post.data.title}
                </a>
                <time class="post-date" datetime={post.data.date.toISOString()}>
                  {post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
                </time>
              </div>
              {post.data.summary && (
                <p class="post-excerpt">{post.data.summary}</p>
              )}
            </li>
          ))}
        </ul>
        <p style="margin-top: 0.75rem;">
          <a href="/notebook" style="font-family: var(--font-mono); font-size: 0.8rem;">all posts →</a>
        </p>
      </div>
      <span class="code-close">{'}'}</span>
    </section>
  )}

</Page>
