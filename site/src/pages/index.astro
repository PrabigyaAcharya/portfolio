---
// index.astro — the landing: a handheld floating on the shell-grey ground.
// Clicking it "switches it on" and goes to /home, the first LCD view.
import Base from '../layouts/Base.astro';
import Handheld from '../components/Handheld.astro';
import { getSiteData } from '../lib/content';

const site = getSiteData();
const [firstName, ...rest] = site.name.split(' ');
const threads = (site.research_threads ?? []).map(t => t.name).join(' · ');

const routes = [
  { href: '/home',     label: 'Home' },
  { href: '/research', label: 'Research' },
  { href: '/notebook', label: 'Notebook' },
  { href: '/now',      label: 'Now' },
  { href: '/cv',       label: 'CV' },
  { href: '/ask',      label: 'Ask this notebook' },
  { href: '/colophon', label: 'Colophon' },
];
---
<Base title={site.name} description={site.tagline}>
  <div class="landing">
    <header class="landing-head">
      <span class="landing-mark"><small>{firstName.toLowerCase()}</small>{rest.join(' ')}</span>
      {threads && <span class="landing-byline">{threads}</span>}
    </header>

    <main class="landing-stage" id="main">
      <h1 class="visually-hidden">{site.name}</h1>
      <Handheld href="/home" />
      <p class="landing-hint">Click the handheld to switch it on</p>

      <nav class="visually-hidden" aria-label="Site">
        <ul>
          {routes.map(r => <li><a href={r.href}>{r.label}</a></li>)}
        </ul>
      </nav>
    </main>
  </div>
</Base>

<style>
  .landing {
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 20px 28px 28px;
    overflow: hidden;
  }

  .landing-head {
    flex: 0 0 auto;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 24px;
    font-family: var(--font-print);
    font-style: italic;
    color: var(--print-blue);
  }
  .landing-mark { font-weight: 700; font-size: 22px; letter-spacing: -0.01em; }
  .landing-mark small { font-weight: 500; font-size: 15px; letter-spacing: 0.02em; margin-right: 8px; }
  .landing-byline { font-weight: 600; font-size: 13px; letter-spacing: 0.06em; }

  .landing-stage {
    flex: 1 1 auto;
    min-height: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 26px;
  }

  .landing-hint {
    font-family: var(--font-print);
    font-style: italic;
    font-weight: 600;
    font-size: 14px;
    letter-spacing: 0.04em;
    color: var(--print-blue);
    text-align: center;
  }

  @media (max-width: 700px) {
    .landing { padding: 16px; gap: 16px; }
    .landing-byline { display: none; }
  }
</style>
