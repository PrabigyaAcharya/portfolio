---
import Screen from '../../layouts/Screen.astro';
import { getCollection } from 'astro:content';
import { getSiteData } from '../../lib/content';

const site = getSiteData();

const allPosts = await getCollection('notebook', ({ data }) => !data.draft);
const posts = allPosts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const allTags = [...new Set(posts.flatMap(p => p.data.tags))].sort();
const fmt = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---
<Screen title="Notebook" description={`Research notes and writings by ${site.name}`} active="notebook">
  <div class="view">
    <h1>Notebook</h1>
    <p class="lcd-small">Notes on research, experiments, and adjacent things.</p>

    {allTags.length > 0 && (
      <nav class="filter-row" aria-label="Filter by tag">
        <a href="#" class="tag" data-tag="">All</a>
        {allTags.map(tag => <a href={`#tag-${tag}`} class="tag" data-tag={tag}>{tag}</a>)}
      </nav>
    )}

    <ul class="lcd-rows" id="post-list">
      {posts.map(post => (
        <li data-tags={post.data.tags.join(',')}>
          <a class="lcd-row" href={`/notebook/${post.slug}`}>
            <span class="row-main">
              <span class="row-title">{post.data.title}</span>
              {post.data.summary && <span class="row-sub">{post.data.summary}</span>}
            </span>
            <time class="row-meta" datetime={post.data.date.toISOString()}>{fmt(post.data.date)}</time>
          </a>
        </li>
      ))}
    </ul>

    <div class="btn-row">
      <a class="lcd-btn" href="/notebook/rss.xml">RSS</a>
    </div>
  </div>
</Screen>

<script>
  function applyFilter() {
    const match = window.location.hash.match(/^#tag-(.+)$/);
    const tag = match ? decodeURIComponent(match[1]) : '';
    document.querySelectorAll<HTMLElement>('[data-tags]').forEach(item => {
      const tags = item.dataset.tags?.split(',') ?? [];
      item.hidden = !!tag && !tags.includes(tag);
    });
    document.querySelectorAll<HTMLElement>('.filter-row .tag').forEach(el => {
      el.setAttribute('aria-current', String(el.dataset.tag === tag));
    });
  }

  applyFilter();
  window.addEventListener('hashchange', applyFilter);
</script>
