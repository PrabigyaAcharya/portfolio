---
import Screen from '../../layouts/Screen.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('notebook', ({ data }) => !data.draft);
  return posts.map(post => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'notebook'>;
}

const { post } = Astro.props;
const { Content } = await post.render();
const math = post.data.math ?? false;

const fmt = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---
<Screen title={post.data.title} description={post.data.summary} math={math} active="notebook">
  <article class="view post">
    <header class="post-head">
      <p class="lcd-label"><a href="/notebook">Notebook</a> /</p>
      <h1>{post.data.title}</h1>
      <p class="lcd-label post-meta">
        <time datetime={post.data.date.toISOString()}>{fmt(post.data.date)}</time>
        {post.data.updated && <span>Updated {fmt(post.data.updated)}</span>}
      </p>
      {post.data.tags.length > 0 && (
        <div class="filter-row">
          {post.data.tags.map(tag => <a href={`/notebook#tag-${tag}`} class="tag">{tag}</a>)}
        </div>
      )}
    </header>

    <div class="prose">
      <Content />
    </div>

    <footer class="btn-row post-foot">
      <a class="lcd-btn" href="/notebook">Back to notebook</a>
      <a class="lcd-btn" href={`/notebook/${post.slug}.md`}>Markdown</a>
    </footer>
  </article>
</Screen>

<style>
  .post-head { display: flex; flex-direction: column; gap: 10px; padding-bottom: 14px; border-bottom: var(--rule-ink); }
  .post-head h1 { max-width: 30ch; }
  .post-meta { display: flex; flex-wrap: wrap; gap: 4px 18px; }
  .post-foot { margin-top: 24px; padding-top: 18px; border-top: var(--rule-ink); }
</style>
