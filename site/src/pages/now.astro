---
import Page from '../layouts/Page.astro';
import { getNow, getSiteData } from '../lib/content';

const now = getNow();
const site = getSiteData();

const updatedDate = new Date(now.updated);
const formattedDate = updatedDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---
<Page title="Now" description={`What ${site.name} is working on right now`}>
  <section class="page-intro">
    <h1>Now</h1>
    <p class="mono" style="font-size: 0.7em; color: var(--ink-ghost); margin-top: 0.25rem;">
      updated <time datetime={now.updated}>{formattedDate}</time>
    </p>
  </section>

  <section aria-labelledby="working-on-heading" class="page-section">
    <h2 id="working-on-heading" class="section-label">working on</h2>
    <ul class="now-list">
      {now.working_on.map(item => (
        <li>{item}</li>
      ))}
    </ul>
  </section>

  <section aria-labelledby="reading-heading" class="page-section">
    <h2 id="reading-heading" class="section-label">reading</h2>
    <ul class="now-list">
      {now.reading.map(item => (
        <li>{item}</li>
      ))}
    </ul>
  </section>

  <section aria-labelledby="open-to-heading" class="page-section">
    <h2 id="open-to-heading" class="section-label">open to</h2>
    <ul class="now-list">
      {now.open_to.map(item => (
        <li>{item}</li>
      ))}
    </ul>
  </section>

  <div slot="margin">
    <div class="margin-note" style="margin-top: 5rem;">
      <span class="margin-stamp">inspired by</span>
      <a href="https://nownownow.com/about" target="_blank" rel="noopener" style="font-style: normal;">nownownow.com</a>
    </div>
  </div>
</Page>
