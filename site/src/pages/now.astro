---
import Screen from '../layouts/Screen.astro';
import { getNow, getSiteData } from '../lib/content';

const now = getNow();
const site = getSiteData();

const formattedDate = new Date(now.updated).toLocaleDateString('en-US', { year: 'numeric', month: 'long' });
const [headline, ...alsoWorkingOn] = now.working_on;
---
<Screen title="Now" description={`What ${site.name} is working on right now`} active="now">
  <div class="view">
    <h1>Now</h1>
    {headline && <p class="lcd-lede">{headline}.</p>}

    {alsoWorkingOn.length > 0 && (
      <ul class="ink-list">
        {alsoWorkingOn.map(item => <li>{item}</li>)}
      </ul>
    )}

    {now.reading.length > 0 && (
      <section class="section">
        <h2>Reading</h2>
        <ul class="ink-list">{now.reading.map(item => <li>{item}</li>)}</ul>
      </section>
    )}

    {now.open_to.length > 0 && (
      <section class="section">
        <h2>Open to</h2>
        <ul class="ink-list">{now.open_to.map(item => <li>{item}</li>)}</ul>
      </section>
    )}

    <p class="lcd-label">
      Updated <time datetime={now.updated}>{formattedDate}</time>
      · <a href="https://nownownow.com/about" target="_blank" rel="noopener">What is this?</a>
    </p>
  </div>
</Screen>
