---
// Screen.astro — every inside page: lilac bezel framing the CRT-style LCD,
// key hints and tab strip on the screen, power button on the bezel. Each tab is a real route, so this works without JS;
// the script below only adds ← → / Enter / Esc and live lab status. With JS, the
// ClientRouter swaps tabs inside one document, so the pixel cursor (and the
// game well) carry across tab changes instead of reloading with the page.
import { ClientRouter } from 'astro:transitions';
import Base from './Base.astro';
import GameWell from '../components/GameWell.astro';
import { getSiteData } from '../lib/content';

export type Tab = 'home' | 'research' | 'notebook' | 'now' | 'cv' | 'ask';

export interface Props {
  title: string;
  description?: string;
  math?: boolean;
  /** Which tab is lit. Omit for pages outside the tab set (404). */
  active?: Tab;
}

const { title, description, math = false, active } = Astro.props;
const site = getSiteData();

const tabs: Array<{ id: Tab; href: string; label: string }> = [
  { id: 'home',     href: '/home',     label: 'Home' },
  { id: 'research', href: '/research', label: 'Research' },
  { id: 'notebook', href: '/notebook', label: 'Notebook' },
  { id: 'now',      href: '/now',      label: 'Now' },
  { id: 'cv',       href: '/cv',       label: 'CV' },
  { id: 'ask',      href: '/ask',      label: 'Ask' },
];

const [firstName, ...rest] = site.name.split(' ');
---
<Base title={title} description={description} math={math}>
  <Fragment slot="head"><ClientRouter /></Fragment>
  <div class="screen-wrap">
    <section class="bezel" aria-label="Display">

      <div class="bezel-bar">
        <div class="bezel-left">
          <a class="power" href="/" aria-label="Switch off" title="Switch off">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M12 3v8" />
              <path d="M6.3 6.8a8 8 0 1 0 11.4 0" />
            </svg>
          </a>
          <div class="bezel-status lab-status" data-poll="/api/lab.json" data-status="idle" title="Lab idle">
            <span class="led" aria-hidden="true"></span>
            <span class="visually-hidden" aria-live="polite">Lab <span data-field="status">idle</span></span>
          </div>
        </div>
        <span class="pinstripe" aria-hidden="true"></span>
        <a class="wordmark" href="/home"><small>{firstName.toLowerCase()}</small>{rest.join(' ')}</a>
      </div>

      <main class="lcd" id="main">
        <div class="lcd-scroll">
          <div class="tab-row">
            <nav class="tabs" aria-label="Screen">
              {tabs.map(t => (
                <a class="tab" href={t.href} data-tab={t.id} aria-current={t.id === active ? 'page' : undefined}>{t.label}</a>
              ))}
            </nav>
            <ul class="key-hints" aria-label="Keyboard shortcuts">
              <li><span class="key key-arrow" aria-hidden="true">←</span><span class="key key-arrow" aria-hidden="true">→</span><span>Browse</span></li>
              <li><span class="key" aria-hidden="true">Enter</span><span>Ask</span></li>
              <li><span class="key" aria-hidden="true">Esc</span><span>Back</span></li>
            </ul>
          </div>
          <slot />
        </div>
        <GameWell />
      </main>

    </section>
  </div>
</Base>

<script>
  import { navigate } from 'astro:transitions/client';

  // These listeners are registered once and survive tab swaps, so they look up
  // the current page's tabs each time rather than holding on to old elements.

  // ── Keyboard: ← → step through tabs, Enter opens Ask, Esc goes Home ───────
  document.addEventListener('keydown', (e) => {
    if (e.defaultPrevented || e.altKey || e.ctrlKey || e.metaKey || e.shiftKey) return;
    const t = e.target;
    const typing = t instanceof HTMLInputElement || t instanceof HTMLTextAreaElement || t instanceof HTMLSelectElement
      || (t instanceof HTMLElement && t.isContentEditable);
    if (typing) return;
    // A game in the well has the keys while it is being played.
    if (t instanceof HTMLElement && t.closest('[data-game-focus]')) return;

    if (e.key === 'ArrowLeft' || e.key === 'ArrowRight') {
      // Let wide code blocks and tables keep native horizontal scrolling.
      if (t instanceof HTMLElement && t.closest('pre, .table-scroll, .katex-display')) return;
      const tabLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('.tabs .tab'));
      const activeIdx = tabLinks.findIndex(a => a.getAttribute('aria-current') === 'page');
      const from = activeIdx === -1 ? 0 : activeIdx;
      const step = e.key === 'ArrowRight' ? 1 : -1;
      const next = tabLinks[(from + step + tabLinks.length) % tabLinks.length];
      if (next) { e.preventDefault(); navigate(next.href); }
      return;
    }

    if (e.key === 'Escape') {
      if (window.location.pathname !== '/home') navigate('/home');
      return;
    }

    if (e.key === 'Enter') {
      // Native Enter on links, buttons and summaries wins.
      if (t instanceof HTMLElement && t.closest('a, button, summary')) return;
      const ask = document.getElementById('ask-input') as HTMLInputElement | null;
      if (ask) { ask.focus(); return; }
      navigate('/ask');
    }
  });

  // ── Lab telemetry: LED in the bezel follows /api/lab.json ─────────────────
  let lastStatus = 'idle';

  function paint() {
    const strip = document.querySelector<HTMLElement>('[data-poll]');
    if (!strip) return;
    strip.dataset.status = lastStatus;
    strip.title = `Lab ${lastStatus}`;
    const word = strip.querySelector<HTMLElement>('[data-field="status"]');
    if (word) word.textContent = lastStatus;
  }

  async function poll() {
    const endpoint = document.querySelector<HTMLElement>('[data-poll]')?.dataset.poll;
    if (!endpoint) return;
    try {
      const res = await fetch(endpoint);
      if (!res.ok) return;
      const data = await res.json() as { status?: string };
      lastStatus = data.status === 'training' ? 'training' : 'idle';
      paint();
    } catch { /* non-critical */ }
  }

  // The bezel is re-rendered on every swap; repaint it from the last reading.
  document.addEventListener('astro:page-load', paint);
  poll();
  setInterval(poll, 60_000);
</script>
