---
import Base from './Base.astro';
import Footer from '../components/Footer.astro';

export interface Props {
  title: string;
  description?: string;
  math?: boolean;
  /** Pass empty array to suppress breadcrumb. Omit for auto-derived. */
  breadcrumb?: Array<{ label: string; href?: string }>;
  /** 'home' uses home-wrap + home-grid; 'default' uses page-container */
  layout?: 'default' | 'home';
}

const { title, description, math = false, breadcrumb, layout = 'default' } = Astro.props;

const crumbs: Array<{ label: string; href?: string }> = breadcrumb ?? (() => {
  const parts = Astro.url.pathname.split('/').filter(Boolean);
  return parts.map((part, i) => ({
    label: decodeURIComponent(part),
    href: i < parts.length - 1 ? '/' + parts.slice(0, i + 1).join('/') : undefined,
  }));
})();

const showBreadcrumb = crumbs.length > 0 && layout !== 'home';
---
<Base title={title} description={description} math={math}>
  {layout === 'home' ? (
    <div class="home-wrap">
      <slot />
    </div>
  ) : (
    <div class="page-container">
      {showBreadcrumb && (
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="/">prabigya</a>
          {crumbs.map(crumb => (
            <>
              <span class="breadcrumb-sep">/</span>
              {crumb.href
                ? <a href={crumb.href}>{crumb.label}</a>
                : <span class="breadcrumb-current">{crumb.label}</span>
              }
            </>
          ))}
        </nav>
      )}
      <slot />
    </div>
  )}
  <Footer slot="footer" />
</Base>
