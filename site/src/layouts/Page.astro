---
import Base from './Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

export interface Props {
  title: string;
  description?: string;
  math?: boolean;
}

const { title, description, math = false } = Astro.props;
---
<Base title={title} description={description} math={math}>
  <Header slot="header" />
  <div class="page">
    <div class="page-main">
      <slot />
    </div>
    <aside class="page-margin" aria-label="Margin notes">
      <slot name="margin" />
    </aside>
  </div>
  <Footer slot="footer" />
</Base>
