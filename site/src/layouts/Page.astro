---
import Base from './Base.astro';
import Footer from '../components/Footer.astro';

export interface Props {
  title: string;
  description?: string;
  math?: boolean;
  /** Pass empty array to suppress breadcrumb (homepage). Omit for auto-derived. */
  breadcrumb?: Array<{ label: string; href?: string }>;
}

const { title, description, math = false, breadcrumb } = Astro.props;

// Auto-derive breadcrumb from URL if not passed
const crumbs: Array<{ label: string; href?: string }> = breadcrumb ?? (() => {
  const parts = Astro.url.pathname.split('/').filter(Boolean);
  return parts.map((part, i) => ({
    label: decodeURIComponent(part),
    href: i < parts.length - 1 ? '/' + parts.slice(0, i + 1).join('/') : undefined,
  }));
})();

const showBreadcrumb = crumbs.length > 0;
---
<Base title={title} description={description} math={math}>
  <div class="page-wrap">
    {showBreadcrumb && (
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">prabigya</a>
        {crumbs.map(crumb => (
          <>
            <span class="breadcrumb-sep">/</span>
            {crumb.href
              ? <a href={crumb.href}>{crumb.label}</a>
              : <span class="breadcrumb-current">{crumb.label}</span>
            }
          </>
        ))}
      </nav>
    )}
    <div class="page">
      <div class="page-main">
        <slot />
      </div>
      <aside class="page-margin" aria-label="Margin notes">
        <slot name="margin" />
      </aside>
    </div>
  </div>
  <Footer slot="footer" />
</Base>
